# SmartNav360 backend configuration.
# Copy to .env and fill in. Validated at boot by config/env.js — the server
# refuses to start rather than failing on the first request.

# ---- Required ----

# MongoDB connection string. Must be a replica set (Atlas, or a single-node
# local replica set): the write paths use transactions.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/smartnav360

# ---- Required in production ----
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. In development these default to an insecure value;
# with NODE_ENV=production the server refuses to start unless you set real ones.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Optional, with defaults ----

NODE_ENV=development
PORT=5000

# How long an access token lives. Short by design — the client refreshes
# transparently using the refresh token.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call this API. Anything not listed
# is rejected by CORS.
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Optional integrations ----
# Without these the relevant feature reports itself unavailable instead of failing.

# Enables real answers in the AI Workspace.
GEMINI_API_KEY=

# Object detection runs locally with YOLOX-S (downloaded by `npm run models:fetch`).
# Set this only to send scenes to your own detection service instead; it
# receives { imageUrl, sceneId } and returns { detections: [{ label, confidence }] }.
YOLO_API_URL=
# Where that service can reach this API, for the image links it is sent.
# Defaults to http://localhost:PORT.
PUBLIC_API_URL=
# Where local object detection and panorama feature matching (SuperPoint +
# LightGlue) run. "auto" (default) times the CPU and each DirectML GPU once
# and uses the fastest; or set cpu, gpu (adapter 0) or gpu:N.
ONNX_DEVICE=
# Where downloaded model weights are kept. Defaults to backend/.cache/models.
MODEL_CACHE_DIR=

# ---- Language model for the AI Workspace ----
# auto: Gemini when GEMINI_API_KEY is set, otherwise a local Ollama model when
# one is running. gemini / ollama force one provider.
LLM_PROVIDER=auto
# A local model served by Ollama (https://ollama.com): run `ollama pull qwen2.5:1.5b`.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ---- Background jobs ----
# Slow work (panorama analysis, upscaling, tiles) runs as background jobs in
# this process. Set a Redis URL to run them through a BullMQ queue instead.
REDIS_URL=

# ---- File storage ----
# local (default): uploads stay in backend/uploads. s3: stored in a bucket.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# Only for S3-compatible services (MinIO, R2, B2).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Public base URL the files are served from (CDN or bucket website URL).
S3_PUBLIC_URL=
