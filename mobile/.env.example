# Optional development fallback only.
#
# At runtime the app resolves the backend in this order:
#   1. the address carried by the scanned SmartNav QR code (?api=...), used
#      for that session only
#   2. the address saved on the device under Server on the home screen
#   3. this value
#
# Leave it unset for demos: open the SmartNav desktop app at the computer's
# network address (http://<lan-ip>:5173) and the QR code carries the backend
# address itself, so no laptop, Wi-Fi network or hotspot is baked into a build.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000
